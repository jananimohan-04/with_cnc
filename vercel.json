{
  "functions": {
    "api/**/*.js": {
      "includeFiles": "server/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/retail-sync/(.*)",
      "destination": "/api/retail-sync"
    },
    {
      "source": "/api/retail-sync",
      "destination": "/api/retail-sync"
    },
    {
      "source": "/download",
      "destination": "/download.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
