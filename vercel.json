{
  "functions": {
    "api/**/*.js": {
      "includeFiles": "server/**",
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/downloads/(cncforge-erp-setup|business-intelligence-setup|Argus-Business-Intelligence-Setup).exe",
      "destination": "/api/desktop/setup",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/retail-sync/(.*)",
      "destination": "/api/retail-sync"
    },
    {
      "source": "/api/retail-sync",
      "destination": "/api/retail-sync"
    },
    {
      "source": "/api/((?!retail-sync).*)",
      "destination": "/api/retail"
    },
    {
      "source": "/download",
      "destination": "/download.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/delete-account",
      "destination": "/delete-account.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
